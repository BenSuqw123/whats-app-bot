# Group filter (keyword whitelist, comma-separated). Leave empty to collect ALL groups.
GROUP_KEYWORDS=sales,support,test

# Toggle chat types (set to 'false' to disable)
LISTEN_GROUPS=true
LISTEN_DMS=true
LISTEN_BROADCASTS=true

LOG_LEVEL=info

# Transient network retries are unlimited. Legacy RECONNECT_MAX_RETRIES is no longer a budget.
RECONNECT_INITIAL_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=120000
STABLE_CONNECTION_MS=60000
CONNECTION_READY_TIMEOUT_MS=60000
SOCKET_END_TIMEOUT_MS=10000
HEALTH_INTERVAL_MS=300000
MEDIA_CONCURRENCY=1
MAX_MEDIA_SIZE_MB=200
MAX_MEDIA_QUEUE=100
# Deadline applies to an entire admitted media batch, including every album item.
MEDIA_DOWNLOAD_TIMEOUT_MS=120000
MAX_SEEN_ALBUMS=5000
SEEN_ALBUM_TTL_MS=1200000
MAX_ALBUM_BUFFERS=100
MAX_ALBUM_ITEMS=100
MAX_GROUP_CACHE=1000
GROUP_CACHE_TTL_MS=900000

# Root folder for the unified archive (default: ./archive)
# Structure:
#   archive/
#     dms/<ChatName>/messages/YYYY-MM-DD.ndjson
#     dms/<ChatName>/images/
#     dms/<ChatName>/videos/
#     groups/<GroupName>/messages/YYYY-MM-DD.ndjson
#     groups/<GroupName>/images/
# ARCHIVE_BASE=./archive
